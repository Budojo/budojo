#!/usr/bin/env sh
# Honour `HUSKY=0` as a kill switch — husky 9 does NOT auto-wrap user
# hooks, so the env var only does anything if we check it ourselves.
# This lets `release.yml` set `HUSKY: "0"` so semantic-release's
# auto-commit of CHANGELOG.md doesn't trip commitlint's
# footer-max-line-length on the long markdown URLs.
[ "${HUSKY:-1}" = "0" ] && exit 0
set -e

# Same graceful skip as `pre-commit`: on a checkout that hasn't run
# `npm install` at the root, `npx --no-install` fails hard and makes every
# commit impossible with an opaque npm error. Warn instead — the message
# says exactly how to turn the gate back on.
if [ -x node_modules/.bin/commitlint ]; then
  npx --no-install commitlint --edit "$1"
else
  printf '  ⚠ commitlint not installed — run `npm install` at the repo root to enable it.\n'
fi
