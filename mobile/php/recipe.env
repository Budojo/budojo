# The PHP the phone runs (#2044). CI builds it from source with static-php-cli,
# on an arm64 runner inside Alpine (musl, fully static), and caches the result
# under this file's hash: change a line here and the next run rebuilds it.
#
# The extensions mirror the desktop's php.exe (desktop/src/php-runtime.ts,
# EXTENSIONS plus the ones built into the Windows runtime). Nothing speculative.
SPC_VERSION=2.8.5
SPC_SHA256=675a3840dcdc4ed041fe20eaa54310ce019a9984c1c03951df9ec66df5795213
PHP_VERSION=8.4
PHP_EXTENSIONS=ctype,curl,dom,fileinfo,filter,iconv,mbstring,openssl,opcache,pdo,pdo_sqlite,phar,session,simplexml,sodium,sqlite3,tokenizer,xml,xmlreader,xmlwriter,zip,zlib
