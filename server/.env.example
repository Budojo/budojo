APP_NAME=Budojo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite everywhere: the test suite already runs on it (see phpunit.xml) and
# the desktop app ships it (#1220). DB_DATABASE must be an ABSOLUTE path —
# Laravel treats a bare name as a relative filename, not a database name.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/api/database/sqlite/budojo.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# CORS allowlist — comma-separated list of origins permitted to call /api/*.
# Local dev defaults to the Angular dev server when unset; production sets it
# via Forge env to the prod SPA origins (e.g. https://budojo.it,https://www.budojo.it).
CORS_ALLOWED_ORIGINS=http://localhost:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Development points at the Mailpit container: every message is caught
# and browsable at http://localhost:8025, so the Mailables can be exercised
# end-to-end with no credentials and no chance of reaching a real inbox.
# PEST still uses the `array` mailer (phpunit.xml), so tests send nothing.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@budojo.it"
MAIL_FROM_NAME="${APP_NAME}"
# Resend was the hosted transport (MAIL_MAILER=resend + RESEND_API_KEY on
# Forge); it went with the cloud stack in #1230. The desktop profile has no
# mail transport at all — MAIL_MAILER=log — and alerts the owner through
# in-app + native notifications (#1225).

# Non-production safety net (#458). When APP_ENV != "production", every
# Mailable's recipient list is rewritten to this address — so a misconfigured
# `MAIL_MAILER=resend` in a dev / staging env can't accidentally ship real
# mail to real customers. Set MAIL_TEST_REDIRECT="" (empty string) to opt
# out — useful when smoke-testing real deliverability. Leaving the var
# commented out / unset falls back to the support inbox shown here.
MAIL_TEST_REDIRECT="matteo.bonanno@budojo.it"

VITE_APP_NAME="${APP_NAME}"

# The SPA origin. Used to build signed links in mail (invites, email
# verification, password reset).
CLIENT_URL=http://localhost:4200

# Document encryption (#224) — AES-256-GCM key used to encrypt medical
# certificates at rest. SEPARATE from APP_KEY so it can be rotated
# independently. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), \"\n\";"
# Blank disables encryption, which is the intended local default: uploads
# stay plaintext and are readable straight off disk while debugging. The
# desktop app generates a real key into the OS keychain on first run
# (#1223) — it is never blank there.
DOCUMENT_ENCRYPTION_KEY=

# Web Push (VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT, #419) was the
# hosted browser-push transport and left with the cloud stack in #1230; the
# desktop profile uses native OS notifications instead (#1225). Unset means
# the subscribe endpoint answers 503 — and on the desktop the whole surface
# is behind the `web_push` capability (404). PEST supplies throwaway keys via
# phpunit.xml. A future web deployment generates its own pair with
#   vendor/bin/web-push generate-vapid

# Seeder — read ONLY by AdminSeeder, which is local/testing only. Set it to
# anything before running `php artisan db:seed`; it becomes the password for
# admin@example.it. Never a real secret, never used outside seeding.
LOCAL_ADMIN_PASSWORD=password

# Runtime profile (#1220) — "web" (hosted SPA + API) or "desktop" (Electron
# shell, one process on one machine; see M11 / #1218). Read it through
# App\Support\Runtime, never with a bare env() call. An unrecognised value
# resolves to "web". The desktop profile also REQUIRES queue=sync,
# cache=file and session=file — DesktopDriverGuard refuses to boot otherwise,
# because a queued job with no worker fails silently rather than loudly.
BUDOJO_RUNTIME=web

# SQLite pragmas. The defaults (WAL / NORMAL / 5000ms) are what the desktop
# app needs and are harmless everywhere else; override only to debug.
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_BUSY_TIMEOUT=5000
