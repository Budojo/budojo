# App
APP_NAME=Budojo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Document encryption (#224) — AES-256-GCM key used to encrypt medical
# certificates at-rest. SEPARATE from APP_KEY so it can be rotated
# independently. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), \"\\n\";"
# Leave blank to disable encryption (uploads stay plaintext, useful for
# local dev). NEVER leave blank in production.
DOCUMENT_ENCRYPTION_KEY=

# Database
DB_ROOT_PASSWORD=secret_root
DB_DATABASE=budojo
DB_USERNAME=budojo_user
DB_PASSWORD=secret

# Laravel DB connection (used inside the api container)
DB_HOST=db
DB_PORT=3306

# Client
CLIENT_URL=http://localhost:4200

# Seeder — only used in local/testing (AdminSeeder)
LOCAL_ADMIN_PASSWORD=
